{
	"compilerOptions": {
		/* ⚙️ Core settings */
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "preserve",

		/* 🧩 Interop & JSON handling */
		"allowJs": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,

		/* 🧠 Type checking & build performance */
		"skipLibCheck": true, // ✅ Big performance win
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"incremental": true,
		"forceConsistentCasingInFileNames": true, // Prevents subtle issues

		/* 💨 Next.js plugin for better IDE hints */
		"plugins": [{ "name": "next" }],

		/* 🎯 Path alias support */
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	},

	/* 🧹 Keep TS server from crawling big folders */
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules", ".next", "dist", "build", "out", "motion"]
}
